{
  "framework": null,
  "regions": ["gru1"],
  "installCommand": "npm ci --prefix web",
  "buildCommand": "npm run build --prefix web",
  "outputDirectory": "web/dist",
  "functions": {"api/index.py": {"includeFiles": "web/public/catalog.json"}, "api/collect.py": {"maxDuration": 240}, "api/team.py": {"maxDuration": 60}, "api/notify.py": {"maxDuration": 240}},
  "rewrites": [{"source": "/api/opportunities", "destination": "/api/index"}],
  "headers": [{"source":"/(.*)","headers":[
    {"key":"X-Content-Type-Options","value":"nosniff"},
    {"key":"Referrer-Policy","value":"no-referrer"},
    {"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=()"},
    {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"}
  ]}]
}
